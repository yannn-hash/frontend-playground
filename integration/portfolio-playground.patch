+.demo-features {
+  display: grid;
+  gap: 12px;
+  margin-top: 30px;
+}
+.demo-features > span {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  font-size: 12px;
+  color: #c6d2bc;
+}
+.demo-features .icon {
+  color: var(--accent);
+  width: 16px;
+  height: 16px;
+}
+.demo-disclaimer {
+  display: flex;
+  gap: 12px;
+  max-width: 365px;
+  padding-top: 28px;
+  margin-top: 30px;
+  border-top: 1px solid #3e4a36;
+  color: #b4c2a7;
+  font-size: 11px;
+  line-height: 1.8;
+}
+.demo-disclaimer > .icon {
+  width: 16px;
+  height: 16px;
+  margin-top: 2px;
+}
+.demo-disclaimer strong {
+  color: #e0e9d6;
+  font-weight: 500;
+}
+.checkout-shell {
+  padding: 28px;
+  border: 1px solid #526046;
+  background: #101611;
+  border-radius: 20px;
+  box-shadow: 0 20px 50px #0c100930;
+  min-width: 0;
+}
+.checkout-header {
+  display: flex;
+  align-items: center;
+  gap: 13px;
+  padding-bottom: 24px;
+  border-bottom: 1px solid #343e30;
+}
+.game-avatar {
+  display: grid;
+  place-items: center;
+  width: 48px;
+  height: 48px;
+  background: #2c3c1f;
+  border: 1px solid #718750;
+  border-radius: 10px;
+  color: var(--accent);
+  flex: none;
+}
+.game-avatar svg {
+  width: 27px;
+  height: 27px;
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 1.1;
+  stroke-linejoin: round;
+}
+.checkout-header h3 {
+  font-size: 17px;
+  font-weight: 600;
+  letter-spacing: -0.3px;
+}
+.checkout-header p {
+  font-size: 10px;
+  color: #aab79f;
+  margin-top: 3px;
+}
+.demo-badge {
+  margin-left: auto;
+  font-family: Consolas, monospace;
+  font-size: 9px;
+  letter-spacing: 1px;
+  padding: 4px 7px;
+  color: var(--accent);
+  border: 1px solid #617144;
+  border-radius: 4px;
+}
+.form-block {
+  margin: 22px 0 0;
+  padding: 0;
+  border: none;
+  min-width: 0;
+}
+.form-block > label,
+.form-block > legend {
+  display: flex;
+  align-items: center;
+  gap: 9px;
+  font-size: 12px;
+  font-weight: 500;
+  margin-bottom: 12px;
+  padding: 0;
+}
+.step-number {
+  display: inline-grid;
+  place-items: center;
+  width: 19px;
+  height: 19px;
+  border: 1px solid #48533e;
+  border-radius: 50%;
+  font-size: 9px;
+  font-weight: 400;
+  color: #cbd7bf;
+  flex: none;
+}
+#player-id {
+  display: block;
+  width: 100%;
+  min-height: 44px;
+  background: #1b241b;
+  border: 1px solid #56624b;
+  border-radius: 7px;
+  padding: 10px 13px;
+  color: var(--text);
+  font-size: 16px;
+  line-height: 1.4;
+}
+#player-id::placeholder {
+  color: #98a88b;
+  font-size: 12px;
+}
+#player-id:focus {
+  border-color: var(--accent);
+}
+#player-id[aria-invalid='true'] {
+  border-color: var(--error);
+}
+.input-hint {
+  font-size: 10px;
+  color: #acb9a0;
+  margin-top: 7px;
+}
+.field-error {
+  font-size: 11px;
+  color: var(--error);
+  margin-top: 7px;
+}
+.package-options {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 9px;
+}
+.package-option {
+  position: relative;
+  cursor: pointer;
+  min-width: 0;
+}
+.package-option > input {
+  position: absolute;
+  opacity: 0;
+  width: 1px;
+  height: 1px;
+  left: 50%;
+  top: 50%;
+}
+.package-content {
+  display: block;
+  position: relative;
+  border: 1px solid #56624b;
+  border-radius: 8px;
+  padding: 15px 10px;
+  background: #1b241b;
+  transition:
+    background-color 0.2s,
+    border-color 0.2s;
+}
+.package-option:hover .package-content {
+  background: #273221;
+}
+.package-option > input:checked + .package-content {
+  border-color: var(--accent);
+  background: #29361f;
+}
+.package-option > input:focus-visible + .package-content {
+  outline: 3px solid var(--accent);
+  outline-offset: 4px;
+}
+.package-diamonds {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 6px;
+}
+.package-diamonds > .icon {
+  width: 14px;
+  height: 14px;
+  color: var(--accent);
+}
+.package-diamonds > strong {
+  font-size: 16px;
+  line-height: 1.2;
+  font-weight: 500;
+}
+.package-diamonds > span {
+  width: 100%;
+  font-size: 9px;
+  color: #b5c3a7;
+  margin-top: 1px;
+}
+.package-price {
+  display: block;
+  margin-top: 12px;
+  font-size: 11px;
+  font-weight: 500;
+  color: #edf3e5;
+  font-variant-numeric: tabular-nums;
+}
+.selection-check {
+  position: absolute;
+  right: 6px;
+  top: 4px;
+  font-size: 9px;
+  color: var(--accent);
+  opacity: 0;
+}
+.package-option > input:checked + .package-content > .selection-check {
+  opacity: 1;
+}
+.payment-options {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 9px;
+}
+.payment-options > label {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  cursor: pointer;
+  padding: 10px;
+  border: 1px solid #56624b;
+  border-radius: 7px;
+  min-height: 44px;
+  background: #1b241b;
+  font-size: 11px;
+}
+.payment-options > label:has(input:checked) {
+  border-color: #a2c869;
+  background: #26331e;
+}
+.payment-options input {
+  accent-color: var(--accent);
+  margin: 0;
+  width: 15px;
+  height: 15px;
+  flex: none;
+}
+.payment-caption {
+  margin-left: auto;
+  font-size: 8px;
+  color: #acb99e;
+}
+.checkout-summary {
+  margin-top: 24px;
+  padding-top: 20px;
+  border-top: 1px solid #3a4632;
+}
+.checkout-summary > div {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+}
+.checkout-summary > div > span {
+  font-size: 11px;
+  color: #c5d0ba;
+}
+.checkout-summary strong {
+  font-size: 22px;
+  letter-spacing: -0.5px;
+  line-height: 1.4;
+  font-weight: 550;
+  font-variant-numeric: tabular-nums;
+  color: var(--accent);
+}
+.checkout-summary > p {
+  font-size: 9px;
+  color: #adba9f;
+  margin-top: 5px;
+  line-height: 1.6;
+}
+.checkout-submit {
+  width: 100%;
+  margin-top: 17px;
+  min-height: 45px;
+  border-radius: 7px;
+  font-size: 12px;
+  justify-content: space-between;
+  padding-inline: 16px;
+}
+.failure-toggle {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin-top: 16px;
+  font-size: 10px;
+  color: #bbc7ae;
+  cursor: pointer;
+  min-height: 32px;
+}
+.failure-toggle > input {
+  accent-color: var(--accent);
+  width: 14px;
+  height: 14px;
+  flex: none;
+  margin: 0;
+}
+.error-summary {
+  border: 1px solid #b78076;
+  background: #382620;
+  border-radius: 8px;
+  padding: 12px 14px;
+  margin-top: 20px;
+  color: var(--error);
+  font-size: 11px;
+}
+.error-summary h4 {
+  font-size: 12px;
+  margin-bottom: 5px;
+}
+.error-summary a {
+  text-decoration: underline;
+  display: block;
+  padding: 5px 0;
+}
+.checkout-result {
+  margin-top: 16px;
+  padding: 12px 14px;
+  border: 1px solid #71934f;
+  border-radius: 8px;
+  background: #25341e;
+  color: #e7f4d8;
+  font-size: 12px;
+}
+.checkout-result[data-state='error'] {
+  border-color: #b78076;
+  background: #382620;
+  color: var(--error);
+}
+
+/* Separate learning playground; the top-up demo remains available below. */
+.playground-teaser {
+  margin-top: 24px;
+  padding: 20px;
+  border: 1px solid var(--border);
+  border-radius: 12px;
+  background: var(--surface);
+}
+.playground-teaser .eyebrow { font-size: 9px; color: var(--accent); margin: 0 0 10px; }
+.playground-teaser h3 { font-size: 18px; line-height: 1.35; margin: 0 0 10px; }
+.playground-teaser > p:not(.eyebrow) { font-size: 13px; line-height: 1.7; color: var(--muted); margin: 0 0 14px; }
+.playground-teaser .text-link { color: var(--accent); font-size: 13px; }
